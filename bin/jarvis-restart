#!/bin/sh
# Restart the wallpaper (after code changes). Uses the pid file, so it never matches other processes.
pid="$(cat "${XDG_RUNTIME_DIR:-/tmp}/jarvis-wall.pid" 2>/dev/null)"
[ -n "$pid" ] && kill "$pid" 2>/dev/null && sleep 0.5
exec hyprctl dispatch exec "$(dirname "$(readlink -f "$0")")/jarvis-wall"
