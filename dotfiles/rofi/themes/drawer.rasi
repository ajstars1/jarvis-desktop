/* App drawer (SUPER+SPACE): Launchpad-style icon grid on a warm umber veil.
   Type to filter, arrows or mouse to pick, Enter or click to open, Esc to close. */

configuration {
    show-icons: true;
    icon-theme: "Yaru";
    drun-display-format: "{name}";
    display-drun: "";
}

* {
    bg:    #ece2d0;
    panel: #e2d4bd;
    line:  #cdb99b;
    dim:   #8f7759;
    text:  #3d2c1f;
    gold:  #a7783f;

    background-color: transparent;
    text-color: @dim;
    font: "DepartureMono Nerd Font 11px";
}

window {
    fullscreen: true;
    background-color: @bg;
    padding: 9% 14%;
}

mainbox {
    children: [ "inputbar", "listview" ];
    spacing: 44px;
}

inputbar {
    children: [ "entry" ];
    margin: 0 32%;
    padding: 0 0 8px 0;
    border: 0 0 1px 0;
    border-color: @line;
}

entry {
    text-color: @text;
    placeholder: "search";
    placeholder-color: @dim;
    horizontal-align: 0.5;
    cursor: text;
}

listview {
    columns: 6;
    lines: 3;
    fixed-columns: true;
    fixed-height: true;
    flow: horizontal;
    spacing: 22px 18px;
    scrollbar: false;
    cycle: false;
}

element {
    orientation: vertical;
    padding: 14px 6px 10px 6px;
    spacing: 10px;
    border-radius: 12px;
    cursor: pointer;
}

element selected.normal,
element selected.active {
    background-color: @panel;
    text-color: @text;
}

element-icon {
    size: 52px;
    horizontal-align: 0.5;
    background-color: transparent;
}

element-text {
    horizontal-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}
