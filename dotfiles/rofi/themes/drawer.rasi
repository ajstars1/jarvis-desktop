/* App list, used when the sotto dock isn't running (the dock has its own Apps list).
   A floating list: name and what the app is on the left, icon on the right.
   Type to filter, arrows or mouse to pick, Enter or click to open, Esc to close. */

configuration {
    show-icons: true;
    icon-theme: "Yaru";
    drun-display-format: "{name}[   <span size='small' foreground='#8f7759'>{generic}</span>]";
    display-drun: "";
}

* {
    bg:      #f3ebde;
    surface: #e2d4bd;
    line:    #cdb99b;
    dim:     #8f7759;
    text:    #3d2c1f;

    background-color: transparent;
    text-color: @text;
    font: "Ubuntu Sans 11";
}

window {
    width: 420px;
    location: center;
    anchor: center;
    background-color: @bg;
    border: 1px;
    border-color: @line;
    border-radius: 16px;
    padding: 12px 8px 8px 8px;
}

mainbox {
    children: [ "inputbar", "listview" ];
    spacing: 6px;
}

inputbar {
    children: [ "entry" ];
    margin: 0 8px;
    padding: 0 2px 10px 2px;
    border: 0 0 1px 0;
    border-color: @surface;
}

entry {
    font: "Ubuntu Sans 13";
    placeholder: "Search apps";
    placeholder-color: #b5a185;
    cursor: text;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    spacing: 0;
}

element {
    children: [ "element-text", "element-icon" ];
    orientation: horizontal;
    padding: 6px 10px;
    spacing: 12px;
    border-radius: 10px;
    cursor: pointer;
}

element selected.normal,
element selected.active {
    background-color: @surface;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}

element-icon {
    size: 30px;
}
