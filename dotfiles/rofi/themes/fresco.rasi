/* fresco: plain text menus (clipboard, keybind help); reverse-video selection */

* {
    bg:      #ece2d0;
    surface: #e2d4bd;
    line:    #cdb99b;
    dim:     #8f7759;
    text:    #3d2c1f;
    accent:  #a7783f;

    background-color: transparent;
    text-color: @text;
    font: "DepartureMono Nerd Font 11px";
}

window {
    width: 44%;
    location: center;
    anchor: center;
    background-color: @bg;
    border: 2px;
    border-color: @text;
    border-radius: 0;
    padding: 0;
}

mainbox {
    children: [ "inputbar", "message", "listview" ];
    spacing: 0;
}

inputbar {
    children: [ "prompt", "entry" ];
    background-color: @text;
    padding: 6px 10px;
    spacing: 8px;
}

prompt {
    text-color: @bg;
}

entry {
    text-color: @bg;
    placeholder: "type to search_";
    placeholder-color: @line;
    cursor: text;
}

message {
    padding: 6px 10px;
    border: 0 0 1px 0;
    border-color: @line;
}

textbox {
    text-color: @dim;
}

listview {
    lines: 10;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    padding: 6px 0;
    spacing: 0;
}

element {
    padding: 3px 10px;
    text-color: @dim;
}

element-text {
    background-color: inherit;
    text-color: inherit;
}

element selected.normal,
element selected.active {
    background-color: @text;
    text-color: @bg;
}

element normal.urgent,
element selected.urgent {
    text-color: #a9532f;
}
