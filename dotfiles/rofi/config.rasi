configuration {
    modi: "drun,run,window";
    show-icons: false;
    display-drun: "RUN>";
    display-run: "CMD>";
    display-window: "WIN>";
    drun-display-format: "{name}";
    matching: "fuzzy";
    sort: true;
    /* one click opens a row (rofi's default is double-click); rows highlight under the mouse */
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: [ MousePrimary, MouseSecondary, MouseDPrimary ];
}

@theme "fresco"
